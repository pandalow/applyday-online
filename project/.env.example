# ApplyDay Environment Variables
# Copy to .env.local for local development

# ──────────────── Database (Supabase) ─────
# Transaction mode pooler — app runtime, Vercel serverless, IPv4-safe (port 6543)
# Supabase Dashboard → Settings → Database → Connection Pooling → Transaction mode
DATABASE_URL=postgresql://postgres.wlyyqimptertaetnoolz:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection — migrations only (drizzle-kit / db:migrate), requires IPv6
# Supabase Dashboard → Settings → Database → URI
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wlyyqimptertaetnoolz.supabase.co:5432/postgres

# ──────────────── Session ─────────────────
# Secret key for JWT session signing (generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-key-change-this-in-production

# ──────────────── AI Providers ────────────
# Provider: openai | anthropic | google (default: openai)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic API Key (optional, if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (optional, if AI_PROVIDER=google)
GOOGLE_API_KEY=...

# ──────────────── App Config ──────────────
# Base URL for the application (used in auth callbacks)
NEXTAUTH_URL=http://localhost:3000

# Node environment
NODE_ENV=development
